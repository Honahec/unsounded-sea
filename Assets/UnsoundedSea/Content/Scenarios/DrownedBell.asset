  objectiveHint: "\u6BCF\u8F6E\u88AD\u51FB\u540E\u822A\u7A0B\u63A8\u8FDB\u4E00\u6BB5\u3002\u5DE8\u6D6A\u7528\u683C\u6321\uFF0C\u949F\u9E23\u7528\u7406\u667A\u9632\u62A4\u6216\u6253\u65AD\uFF1B\u706B\u529B\u4E0D\u80FD\u4EE3\u66FF\u64A4\u79BB\u3002"
