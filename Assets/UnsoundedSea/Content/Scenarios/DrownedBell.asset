  introduction: "\u90A3\u4E0D\u662F\u4E00\u5EA7\u5C9B\u3002\u6491\u8FC7\u4E94\u8F6E\u88AD\u51FB\uFF0C\u4FDD\u6301\u8239\u5458\u751F\u547D\u4E0E\u7406\u667A\u3002"
  objectiveHeading: "\u6D3B\u7740\u9A76\u79BB\u5B83\u7684\u9634\u5F71\u3002"
  taskLabel: 
  victoryText: "\u7B2C\u4E94\u9053\u6D6A\u843D\u5728\u4E86\u8239\u5C3E\u3002\u5DE8\u5927\u7684\u8F6E\u5ED3\u7EC8\u4E8E\u88AB\u6D53\u96FE\u541E\u6CA1\u3002\n\u4F60\u6CA1\u6709\u51FB\u8D25\u5B83\uFF0C\u53EA\u662F\u9A76\u51FA\u4E86\u5B83\u7684\u76EE\u5149\u3002"
  defeatText: "\u8239\u8237\u7684\u706F\u63A5\u8FDE\u7184\u706D\u3002\n\u6700\u540E\u4E00\u58F0\u949F\u9E23\uFF0C\u6765\u81EA\u4F60\u81EA\u5DF1\u7684\u80F8\u8154\u3002"
