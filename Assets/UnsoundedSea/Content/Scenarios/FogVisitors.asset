  chapter: "01 / \u96FE\u6D77\u6765\u5BA2"
  location: "\u9E26\u53F7\u8C03\u67E5\u8239 \xB7 \u5317\u7EAC 47\xB0 \xB7 02:17"
  introduction: "\u96FE\u4E2D\u591A\u4E86\u4E24\u4F4D\u4E58\u5BA2\u3002\u6BCF\u56DE\u5408\u523B\u4E0B\u4E00\u6BB5\u5C01\u7EBF\uFF0C\u540C\u65F6\u9632\u5907\u5B83\u4EEC\u7684\u884C\u52A8\u3002"
  objectiveHeading: "\u4E0D\u8981\u8BD5\u56FE\u6740\u6B7B\u6D77\u3002"
  taskLabel: "\u523B\u4E0B\u5C01\u7EBF"
  victoryText: "\u7B2C\u56DB\u6BB5\u5C01\u7EBF\u95ED\u5408\u3002\u8239\u5934\u7EC8\u4E8E\u5212\u5F00\u6D53\u96FE\u3002\n\u8EAB\u540E\u7684\u811A\u6B65\u6D88\u5931\u4E86\uFF0C\u6D77\u56FE\u4E0A\u5374\u591A\u51FA\u4E00\u6761\u4E0D\u5C5E\u4E8E\u4F60\u7684\u7B14\u8FF9\u3002"
  defeatText: "\u547C\u53F7\u6DF9\u6CA1\u5728\u6F6E\u58F0\u91CC\u3002\n\u6CA1\u6709\u4EBA\u80FD\u786E\u5B9A\uFF0C\u8239\u4E0A\u7A76\u7ADF\u66FE\u6709\u591A\u5C11\u4E58\u5BA2\u3002"
