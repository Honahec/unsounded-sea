  enemyHeading: "01   /   \u7532\u677F\u4E0A\u7684\u6765\u5BA2"
  objectiveHint: "\u7ED8\u5236\u5C01\u7EBF\u57FA\u7840\u6D88\u80173\u884C\u52A8\u3001\u6BCF\u56DE\u5408\u4E00\u6B21\uFF1B\u5408\u6CD5\u573A\u666F\u6298\u6263\u7167\u5E38\u751F\u6548\u300220\u751F\u547D\u91CD\u538B\u4E0D\u53EF\u6253\u65AD\uFF0C10\u7406\u667A\u94C3\u9E23\u53EF\u6253\u65AD\u3002"
  enemyStatus: 
  introduction: "\u5728\u56DE\u58F0\u7684\u516C\u5F00\u91CD\u538B\u4E0B\u5B8C\u6210\u56DB\u6BB5\u5C01\u7EBF\uFF1B\u6309\u9884\u544A\u5B89\u6392\u9632\u62A4\u6216\u628A\u6253\u65AD\u7559\u7ED9\u94C3\u9E23\u3002"
  objectiveHeading: "\u4E0D\u8981\u8BD5\u56FE\u6740\u6B7B\u6D77\u3002"
  taskLabel: "\u523B\u4E0B\u5C01\u7EBF"
  victoryText: "\u7B2C\u56DB\u6BB5\u5C01\u7EBF\u95ED\u5408\u3002\u8239\u5934\u7EC8\u4E8E\u5212\u5F00\u6D53\u96FE\u3002\n\u8EAB\u540E\u7684\u811A\u6B65\u6D88\u5931\u4E86\uFF0C\u6D77\u56FE\u4E0A\u5374\u591A\u51FA\u4E00\u6761\u4E0D\u5C5E\u4E8E\u4F60\u7684\u7B14\u8FF9\u3002"
  defeatText: "\u547C\u53F7\u6DF9\u6CA1\u5728\u6F6E\u58F0\u91CC\u3002\n\u6CA1\u6709\u4EBA\u80FD\u786E\u5B9A\uFF0C\u8239\u4E0A\u7A76\u7ADF\u66FE\u6709\u591A\u5C11\u4E58\u5BA2\u3002"
