.voyage-map-panel {
    position: absolute;
    left: 225px;
    right: 165px;
    top: 8px;
    bottom: 0;
    padding: 14px 20px 10px;
    background-color: rgba(7, 24, 27, 0.97);
    border-left-width: 3px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-color: rgb(139, 112, 65);
}
.map-heading { min-height: 48px; flex-shrink: 0; padding: 4px 8px 12px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(185, 151, 89, 0.48); }
.voyage-map-panel .map-title { margin: 0; color: rgb(232, 214, 169); font-size: 22px; letter-spacing: 2px; white-space: nowrap; }
.map-empty { flex-grow: 1; color: rgb(165, 174, 149); font-size: 15px; letter-spacing: 2px; -unity-text-align: middle-center; }
.map-chart-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin: 10px 0; }
.map-chart-scroll .unity-scroll-view__content-viewport { background-color: rgba(10, 36, 38, 0.76); }
.map-chart-scroll .unity-scroll-view__vertical-scroller { width: 18px; }
.nautical-chart { height: 1280px; flex-shrink: 0; overflow: hidden; background-color: rgba(10, 36, 38, 0.76); }
.voyage-map-panel .chart-node { position: absolute; width: 112px; height: 58px; padding: 0; translate: -50% -50%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.voyage-map-panel .chart-node:disabled { opacity: 1; }
.voyage-map-panel .chart-node:hover, .voyage-map-panel .chart-node:focus { background-color: rgba(20, 54, 51, 0.82); border-width: 1px; border-color: rgb(185, 151, 89); }
.node-glyph { position: absolute; left: 50%; top: 50%; width: 38px; height: 38px; translate: -50% -50%; border-radius: 19px; background-color: rgb(11, 31, 33); }
.node-name { position: absolute; left: -24px; right: -24px; padding: 3px 5px; color: rgb(222, 216, 188); background-color: rgba(7, 24, 27, 0.88); font-size: 16px; -unity-text-align: middle-center; }
.node-name.label-above { bottom: 49px; }
.node-name.label-below { top: 49px; }
.node-perilous { position: absolute; right: 2px; top: 2px; min-width: 22px; height: 22px; padding: 0 4px; border-width: 1px; border-radius: 11px; border-color: rgb(242, 188, 157); background-color: rgb(77, 42, 39); color: rgb(255, 226, 203); font-size: 11px; white-space: nowrap; -unity-text-align: middle-center; }
.chart-node.current .node-glyph { border-width: 2px; border-color: rgb(113, 188, 165); background-color: rgb(20, 61, 58); }
.chart-node.available .node-glyph { border-width: 2px; border-color: rgb(224, 194, 121); }
.chart-node.selected .node-glyph { border-width: 3px; border-color: rgb(232, 214, 169); background-color: rgb(111, 75, 34); }
.chart-node.visited .node-glyph { border-width: 1px; border-color: rgb(85, 151, 131); }
.chart-node.charted .node-glyph { opacity: 0.7; }
.chart-node.current .node-name { color: rgb(143, 211, 189); }
.chart-node.available .node-name, .chart-node.selected .node-name { color: rgb(239, 207, 132); }
.chart-ship { position: absolute; width: 8px; height: 19px; translate: -50% -145%; rotate: 18deg; background-color: rgb(232, 214, 169); border-top-left-radius: 7px; border-top-right-radius: 7px; border-width: 2px; border-color: rgb(88, 55, 28); }
.chart-compass { position: absolute; left: 18px; bottom: 15px; width: 74px; height: 74px; opacity: 0.68; }
.chart-fog { position: absolute; right: 3%; top: 17%; bottom: 17%; width: 68px; padding-left: 17px; color: rgba(169, 188, 171, 0.58); border-left-width: 1px; border-left-color: rgba(147, 176, 163, 0.35); font-size: 12px; letter-spacing: 4px; white-space: normal; -unity-text-align: middle-center; }
.map-legend { min-height: 48px; flex-shrink: 0; padding: 8px 0 2px; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; border-top-width: 1px; border-top-color: rgba(185, 151, 89, 0.38); }
.map-legend-item { margin: 5px 14px; flex-shrink: 0; flex-direction: row; align-items: center; }
.map-legend-mark { width: 12px; height: 12px; flex-shrink: 0; margin-right: 8px; border-radius: 6px; border-width: 1px; border-color: rgb(149, 157, 135); background-color: rgb(16, 44, 44); }
.map-legend-mark.current { border-color: rgb(113, 188, 165); background-color: rgb(35, 91, 81); }
.map-legend-mark.available { border-color: rgb(224, 194, 121); }
.map-legend-mark.selected { border-color: rgb(232, 214, 169); background-color: rgb(111, 75, 34); }
.map-legend-mark.visited { border-color: rgb(85, 151, 131); }
.voyage-map-panel .map-legend-label { margin: 0; color: rgb(190, 188, 163); font-size: 14px; white-space: nowrap; }
.map-perilous-badge { position: absolute; right: -12px; top: -12px; width: 24px; height: 24px; }
