/* Ink, aged brass and ivory; the sea remains the title screen's dominant image. */
/* Shared scroll hardware: dark channel, brass grip, ivory focus; keep native input. */
.unity-scroll-view .unity-scroller { background-color: #0b1c1e; border-width: 1px; border-color: #53645d; border-radius: 4px; }
.unity-scroll-view .unity-scroller--vertical { width: 24px; margin-left: 8px; }
.unity-scroll-view .unity-scroller--horizontal { height: 24px; margin-top: 8px; }
.unity-scroll-view .unity-scroller--vertical .unity-base-slider { margin-top: 22px; margin-bottom: 22px; }
.unity-scroll-view .unity-scroller--horizontal .unity-base-slider { margin-left: 22px; margin-right: 22px; }
.unity-scroll-view .unity-scroller .unity-base-slider__tracker { background-color: #263e36; border-width: 1px; border-color: #53645d; border-radius: 2px; }
.unity-scroll-view .unity-scroller .unity-base-slider__dragger { background-image: none; background-color: #9e8755; border-width: 2px; border-color: #d7bd82; border-radius: 4px; }
.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger { min-height: 32px; width: 12px; margin-left: 4px; }
.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger { min-width: 32px; }
.unity-scroll-view .unity-scroller .unity-base-slider__dragger-border { display: none; }
.unity-scroll-view .unity-scroller .unity-base-slider:hover .unity-base-slider__dragger { background-color: #c6ad71; }
.unity-scroll-view .unity-scroller .unity-base-slider:focus .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller .unity-base-slider:active .unity-base-slider__dragger { background-color: #d7bd82; border-color: #fff0c6; }
.unity-scroll-view .unity-scroller .unity-scroller__low-button,
.unity-scroll-view .unity-scroller .unity-scroller__high-button { width: 22px; height: 22px; min-width: 22px; min-height: 22px; margin: 0; padding: 0; background-color: #19332f; -unity-background-image-tint-color: #d7bd82; border-width: 1px; border-color: #53645d; border-radius: 3px; }
.unity-scroll-view .unity-scroller .unity-scroller__low-button:hover,
.unity-scroll-view .unity-scroller .unity-scroller__high-button:hover { background-color: #355248; border-color: #9e8755; }
.unity-scroll-view .unity-scroller .unity-scroller__low-button:focus,
.unity-scroll-view .unity-scroller .unity-scroller__high-button:focus { border-color: #fff0c6; }
.unity-scroll-view .unity-scroller:disabled { opacity: .4; }
.unity-label { white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; }
.game-menu { background-color: rgba(0,0,0,0); color: #eee4c9; font-size: 16px; }
.game-menu Button, .settings Button, .pause Button { margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0); color: #eee4c9; -unity-text-align: middle-center; transition-property: translate, background-color, border-color; transition-duration: 0.12s; }
.reduced-motion Button { transition-duration: 0s; }
.game-menu Button:disabled, .settings Button:disabled, .pause Button:disabled { opacity: 0.45; }
.menu-apparition { position: absolute; right: 8%; top: 12%; width: 620px; height: 620px; opacity: 0.22; rotate: -18deg; }
.menu-column { position: absolute; left: 9%; top: 16%; width: 440px; }
.menu-title-block { margin-bottom: 32px; }
.menu-overline { font-size: 13px; color: #9e8755; letter-spacing: 5px; text-shadow: 0 2px 6px #081316; }
.menu-title { font-size: 66px; color: #eee4c9; letter-spacing: 10px; margin-top: 8px; text-shadow: 0 3px 10px #081316; }
.menu-rule { width: 178px; height: 1px; margin-top: 22px; background-color: #9e8755; rotate: -2deg; }
.menu-entries { width: 320px; }
.game-menu .menu-entry { flex-direction: row; align-items: center; justify-content: flex-start; min-height: 58px; padding: 0 12px 0 0; margin-bottom: 4px; border-width: 0; }
.entry-mark { width: 46px; height: 46px; margin-right: 16px; opacity: 0.28; }
.entry-text { flex-grow: 1; }
.entry-title { font-size: 27px; color: #eee4c9; letter-spacing: 5px; text-shadow: 0 2px 5px #081316; }
.game-menu .menu-entry:hover, .game-menu .menu-entry:focus, .game-menu .menu-entry.open { background-color: rgba(0,0,0,0); translate: 8px 0; }
.game-menu .menu-entry:hover .entry-mark, .game-menu .menu-entry:focus .entry-mark, .game-menu .menu-entry.open .entry-mark { opacity: 1; }
.game-menu .menu-entry:focus .entry-title, .game-menu .menu-entry:hover .entry-title { color: #ffe5a6; }
.game-menu .menu-entry:active { translate: 4px 0; }
.menu-settings-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(3,9,11,0.78); }
.menu-settings-scrim .settings { left: 50%; top: 50%; translate: -50% -50%; }
.menu-error { padding: 14px; color: #f2bc9d; background-color: #342527; font-size: 16px; }
.debug-selector { position: absolute; left: 16%; right: 16%; top: 7%; bottom: 7%; padding: 26px 32px; background-color: rgba(5,15,18,.97); border-width: 1px; border-color: #9e8755; border-top-left-radius: 28px; border-bottom-right-radius: 28px; color: #eee4c9; }
.debug-head { flex-direction: row; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(158,135,85,.45); }
.debug-title { font-size: 30px; letter-spacing: 6px; color: #eee4c9; margin-right: 24px; }
.debug-note { font-size: 15px; color: #d7bd82; }
.debug-levels { flex-grow: 1; min-height: 0; }
.debug-group { margin: 18px 6px 7px; color: #d7bd82; font-size: 18px; letter-spacing: 3px; }
.game-menu .debug-level { min-height: 48px; margin: 2px 6px; padding: 8px 14px; background-color: rgba(25,51,47,.72); border-left-width: 2px; border-left-color: #53645d; color: #eee4c9; font-size: 17px; -unity-text-align: middle-left; }
.game-menu .debug-level:hover { background-color: #263e36; border-left-color: #d7bd82; }
.game-menu .debug-level:focus { background-color: #355248; border-width: 2px; border-color: #fff0c6; }
.game-menu .debug-close { align-self: flex-end; min-width: 180px; min-height: 48px; margin-top: 14px; padding: 8px 18px; background-color: #263e36; border-width: 1px; border-color: #9e8755; color: #eee4c9; font-size: 16px; }
.game-menu .debug-close:focus { border-width: 2px; border-color: #fff0c6; }
.settings { position: absolute; left: 50%; top: 50%; width: 620px; max-width: 94%; max-height: 90%; translate: -50% -50%; padding: 24px 28px; background-color: rgba(8,19,22,0.97); border-width: 1px; border-color: #9e8755; border-top-width: 3px; border-top-left-radius: 28px; border-bottom-right-radius: 28px; color: #eee4c9; }
.pause-scrim .settings { left: 50%; top: 50%; translate: -50% -50%; }
.settings-scroll { flex-shrink: 1; min-height: 0; }
.settings .settings-head { padding-bottom: 20px; margin-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(158,135,85,0.45); }
.settings .settings-title { font-size: 28px; color: #eee4c9; letter-spacing: 8px; }
.settings .settings-row { flex-direction: row; justify-content: space-between; align-items: center; min-height: 66px; }
.settings .settings-labels { flex-shrink: 1; margin-right: 16px; }
.settings .settings-name { font-size: 19px; color: #eee4c9; }
.settings .choice { flex-direction: row; flex-shrink: 0; }
.settings .choice-option { min-width: 74px; height: 38px; padding: 6px 14px; margin-left: 6px; font-size: 17px; color: #9faea6; border-bottom-width: 1px; border-color: #53645d; }
.settings .choice-option:hover { background-color: #203631; }
.settings .choice-option.selected { background-color: #263e36; color: #eee4c9; border-color: #c6ad71; }
.settings .choice-option:focus { border-width: 2px; border-color: #e4cc92; }
.settings .volume { flex-direction: row; align-items: center; flex-shrink: 0; }
.settings .volume-step { width: 34px; min-width: 34px; height: 38px; flex-shrink: 0; font-size: 22px; color: #eee4c9; border-width: 1px; border-color: #9e8755; }
.settings .volume-step:hover { background-color: #263e36; }
.settings .volume-step:focus { border-width: 2px; border-color: #e4cc92; }
.settings .volume-steps { flex-direction: row; flex-shrink: 0; margin: 0 8px; }
.settings .volume-pip { width: 8px; min-width: 8px; height: 20px; flex-shrink: 0; margin: 0 2px; border-width: 1px; border-color: #53645d; }
.settings .volume-pip.filled { background-color: #80b5a5; border-color: #80b5a5; }
.settings .volume-value { font-size: 16px; color: #eee4c9; width: 58px; min-width: 58px; flex-shrink: 0; white-space: nowrap; -unity-text-align: middle-right; }
.settings .settings-foot { flex-direction: row; justify-content: flex-end; margin-top: 24px; }
.settings .settings-secondary { padding: 10px 16px; font-size: 16px; color: #a9b6ad; margin-right: 12px; }
.settings .settings-secondary:hover { color: #eee4c9; }
.settings .settings-primary { padding: 10px 24px; font-size: 18px; color: #eee4c9; background-color: #263e36; border-width: 1px; border-color: #9e8755; }
.settings .settings-primary:hover { background-color: #355248; }
.settings .settings-secondary:focus, .settings .settings-primary:focus { border-width: 2px; border-color: #e4cc92; }
.pause-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(3,9,11,0.72); }
.pause { position: absolute; left: 50%; top: 25%; translate: -50% 0; width: 300px; padding: 18px 0; align-items: stretch; background-color: rgba(4,12,14,0.82); border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(158,135,85,0.65); }
.pause .pause-overline { margin-bottom: 16px; font-size: 25px; color: #eee4c9; letter-spacing: 7px; -unity-text-align: middle-center; }
.pause .pause-option { min-height: 48px; padding: 10px 12px; font-size: 17px; letter-spacing: 2px; border-bottom-width: 1px; border-color: rgba(158,135,85,0.28); background-color: transparent; }
.pause .pause-option:hover { color: #fff0c9; background-color: rgba(38,62,54,0.45); }
.pause .pause-option:focus { border-left-width: 2px; border-right-width: 2px; border-color: #e4cc92; }
.pause .pause-option:active { background-color: rgba(53,82,72,0.55); }
.pause .pause-option.danger { color: #e6b19b; }
.pause .pause-option.danger:hover { background-color: rgba(73,51,44,0.55); }
.game-menu .entry-title, .settings Button, .pause .pause-option, .battle-action-book-tool, .battle-action-book-close, #collection-save, #collection-close { white-space: nowrap; }
.enemy-details { width: 100%; margin-top: 4px; }
.enemy-clue-lines { font-size: 13px; color: #eee4c9; white-space: normal; -unity-text-align: middle-left; }
.enemy-intent-row { flex-direction: row; align-items: center; padding: 3px 0; }
.enemy-intent-icon { width: 22px; height: 22px; margin-right: 5px; flex-shrink: 0; }
.enemy-intent-action { width: 76px; flex-shrink: 0; font-size: 14px; color: #d7bd82; -unity-text-align: upper-left; }
.enemy-intent-effect { flex-grow: 1; flex-shrink: 1; font-size: 14px; color: #eee4c9; white-space: normal; -unity-text-align: upper-left; }
.enemy-intent-row.confirmed .enemy-intent-effect { color: #a7dbca; }
.battle-action-book-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 5% 8%; align-items: center; background-color: rgba(1,8,13,.96); color: #eee4c9; }
.battle-action-book-sheet { width: 1100px; max-width: 100%; flex-grow: 1; min-height: 0; padding: 22px 28px; background-color: rgba(8,19,22,.96); border-width: 1px; border-color: #9e8755; }
.battle-action-book-title { flex-shrink: 0; margin-bottom: 18px; font-size: 28px; letter-spacing: 5px; color: #eee4c9; }
.battle-action-book-body { flex-grow: 1; flex-shrink: 1; flex-direction: row; min-width: 0; min-height: 0; }
.battle-action-book-side { width: 230px; min-width: 230px; flex-shrink: 0; padding-right: 24px; border-right-width: 1px; border-right-color: rgba(158,135,85,.4); }
.battle-action-book-main { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; padding-left: 24px; }
.battle-action-book-tool-title { margin-bottom: 8px; color: #d7bd82; font-size: 14px; letter-spacing: 1px; }
.battle-action-book-tool { min-height: 42px; margin-top: 8px; padding: 10px 12px; border-left-width: 3px; border-left-color: #d7bd82; background-color: rgba(38,62,54,.55); color: #eee4c9; }
.battle-action-book-close { margin-top: auto; min-width: 100px; min-height: 42px; color: #eee4c9; border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(158,135,85,.45); background-color: transparent; }
.battle-action-book-main > .collection-count { align-self: flex-end; }
.battle-action-book-sheet .collection-scroll { flex-grow: 1; min-height: 0; margin-top: 10px; }
.battle-action-book-sheet .collection-list .collection-card { margin: 12px; }

.card-collection { position: absolute; left: 6%; right: 6%; top: 5%; bottom: 5%; min-width: 0; min-height: 0; padding: 22px 28px; background-color: rgba(5,15,18,.94); border-width: 1px; border-color: #9e8755; border-top-left-radius: 28px; border-bottom-right-radius: 28px; color: #eee4c9; }
.collection-head { flex-direction: row; flex-shrink: 0; align-items: center; margin-bottom: 14px; }
.collection-title { flex-shrink: 0; font-size: 30px; color: #eee4c9; letter-spacing: 6px; margin-right: 24px; }
.collection-copy { flex-grow: 1; flex-shrink: 1; color: #a9b6ad; font-size: 14px; }
.collection-count { flex-shrink: 0; color: #d7bd82; font-size: 17px; margin-left: 20px; }
.collection-body { flex-grow: 1; flex-shrink: 1; flex-direction: row; min-width: 0; min-height: 0; }
.collection-browser { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; margin-right: 28px; }
.collection-list { flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.collection-list .collection-card { width: 150px; height: 225px; margin: 5px; padding: 0; border-width: 1px; border-color: rgba(158,135,85,.45); border-radius: 8px; background-color: #0f1d21; }
.collection-card.selected { border-width: 3px; border-color: #d7bd82; }
.collection-card:focus { border-width: 3px; border-color: #eee4c9; }
.collection-card-face { width: 100%; height: 100%; border-radius: 7px; }
.collection-pages { height: 42px; flex-shrink: 0; flex-direction: row; justify-content: center; }
.collection-pages Button, .collection-detail Button { min-width: 110px; margin: 5px; padding: 8px 14px; border-width: 1px; border-color: #9e8755; background-color: #19383c; color: #eee4c9; }
.collection-pages Button:focus, .collection-detail Button:focus { border-width: 2px; border-color: #eee4c9; }
.collection-detail { width: 350px; min-width: 350px; min-height: 0; flex-shrink: 0; align-items: stretch; }
.collection-detail-card { width: 300px; height: 450px; flex-shrink: 0; align-self: center; border-width: 1px; border-color: #9e8755; border-radius: 12px; }
.collection-detail .collection-toggle { flex-shrink: 0; background-color: #355248; color: #fff0c9; margin-top: 12px; }
.collection-crew { flex-shrink: 0; margin-top: 8px; padding: 8px; border-top-width: 1px; border-color: rgba(158,135,85,.45); }
.collection-crew-title { color: #d7bd82; font-size: 14px; margin-bottom: 4px; }
.collection-crew Button { min-height: 34px; margin: 2px 0; padding: 5px 8px; border-width: 1px; border-color: #53645d; background-color: rgba(8,19,22,.9); color: #a9b6ad; }
.collection-crew Button.selected { color: #fff0c9; border-color: #d7bd82; background-color: #263e36; }
.collection-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.collection-scroll .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.collection-detail > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: stretch; }
.card-inspection { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(1,8,13,.88); }
.card-inspection-face { width: 340px; height: 510px; border-width: 2px; border-color: #d7bd82; border-radius: 14px; }
.card-inspection-face #illustrated-rules { min-height: 42%; }
.card-inspection-face #illustrated-description { font-size: 17px; }
.card-inspection-close { width: 150px; min-height: 42px; margin-top: 12px; border-width: 1px; border-color: #d7bd82; background-color: #19383c; color: #eee4c9; }
.card-inspection-close:focus { border-width: 2px; border-color: #eee4c9; }
.card-target-options { flex-grow: 1; min-height: 0; }
.card-detail-hint { position: absolute; right: 7px; top: 9px; padding: 2px 5px; font-size: 10px; color: #ebe0be; background-color: rgba(5,15,19,.75); }
.pending-choice { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(1,8,13,.92); }
.pending-choice-sheet { width: 560px; max-height: 76%; padding: 24px 30px; background-color: #0f1f23; border-width: 2px; border-color: #d7bd82; border-top-left-radius: 28px; border-bottom-right-radius: 28px; }
.pending-choice-title { margin-bottom: 14px; color: #fff0c9; font-size: 22px; -unity-text-align: middle-center; }
.pending-choice-options { flex-grow: 1; min-height: 0; }
.game-menu Button, .voyage-hud Button, .ocean-ui .sea-button, .ocean-ui .tool,
.ocean-ui .boss-target, .ocean-ui .card-target-choice, .ocean-ui .pause-option {
    transition-property: background-color, color, border-color, scale;
    transition-duration: .14s;
    transition-timing-function: ease-out-cubic;
}
.game-menu Button:active, .voyage-hud Button:active { scale: 0.98; }
.reduced-motion Button { transition-duration: 0s; }
