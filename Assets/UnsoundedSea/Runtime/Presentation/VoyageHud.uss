/* Quiet edge controls leave the vessel and sea unobstructed. */
.voyage-hud { background-color: rgba(0, 0, 0, 0); color: #e5e2d6; font-size: 15px; }
.voyage-hud Label { white-space: normal; -unity-text-align: middle-left; }
.voyage-hud Button { margin: 0; padding: 9px 14px; min-height: 40px; border-width: 1px; border-radius: 2px; border-color: rgba(164, 166, 151, 0.28); background-color: rgba(8, 19, 22, 0.82); color: #e5e2d6; white-space: normal; transition-property: background-color, border-color; transition-duration: 0.12s; }
.voyage-hud Button:hover { border-color: #b3a482; background-color: rgba(31, 47, 47, 0.94); }
.voyage-hud Button:focus { border-color: #eee4c9; }
.voyage-hud Button:active { background-color: #334541; }
.voyage-hud Button:disabled { opacity: 0.45; }
.voyage-hud.reduced-motion Button { transition-duration: 0s; }
.voyage-header { position: absolute; top: 24px; left: 36px; right: 36px; height: 40px; flex-direction: row; align-items: center; justify-content: flex-end; }
.voyage-utilities { flex-direction: row; align-items: center; }
.voyage-utilities .secondary { margin-left: 12px; min-width: 84px; min-height: 36px; padding: 6px 10px; border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); font-size: 14px; -unity-text-align: middle-center; }
.voyage-utilities .secondary:hover, .voyage-utilities .secondary:focus { border-bottom-color: #b3a482; background-color: rgba(8, 19, 22, 0.65); }
.voyage-workspace { position: absolute; left: 36px; right: 36px; top: 78px; bottom: 36px; }
.current-location { position: absolute; left: 0; top: 0; width: 260px; }
.location-name { font-size: 23px; color: #e5e2d6; letter-spacing: 2px; text-shadow: 0 2px 5px #040a0c; }
.section-label { margin-top: 7px; margin-bottom: 5px; font-size: 12px; color: #a9b6ad; letter-spacing: 2px; }
.panel-title { margin-bottom: 4px; font-size: 20px; color: #e5e2d6; }
.body { margin-bottom: 9px; font-size: 15px; color: #e2dcc6; }
.muted { margin-bottom: 7px; font-size: 13px; color: #a9b6ad; }
.fact { margin-top: 4px; font-size: 13px; color: #a9b6ad; }
.voyage-navigation { position: absolute; right: 0; bottom: 0; width: 316px; }
.route-list { margin-bottom: 14px; }
.voyage-hud .route-choice { flex-direction: row; align-items: center; min-height: 74px; padding: 10px 14px; margin-bottom: 5px; border-width: 1px; border-left-width: 2px; border-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(164, 166, 151, 0.25); background-color: rgba(8, 19, 22, 0.68); }
.voyage-hud .route-choice:hover { background-color: rgba(26, 42, 43, 0.93); border-bottom-color: #b3a482; }
.voyage-hud .route-choice:focus { border-color: #eee4c9; }
.voyage-hud .route-choice.selected { border-left-color: #c6ad71; background-color: rgba(33, 48, 47, 0.94); }
.route-description { flex-grow: 1; flex-shrink: 1; }
.route-name { font-size: 20px; color: #e5e2d6; }
.route-duration { margin-top: 5px; font-size: 13px; color: #a9b6ad; }
.route-choice.selected .route-name, .route-choice.selected .route-duration { color: #e5d4aa; }
.destination-panel { align-items: stretch; }
.choosing-route .destination-panel { min-height: 116px; }
.destination-title { margin-bottom: 8px; font-size: 23px; color: #e5e2d6; letter-spacing: 1px; }
.bearing { margin-bottom: 6px; font-size: 13px; color: #c6b58e; }
.destination-clue { min-height: 42px; font-size: 15px; color: #bdc7bf; text-shadow: 0 2px 5px #040a0c; }
.voyage-hud .primary { margin-top: 16px; padding: 10px 20px; min-height: 44px; border-radius: 2px; background-color: rgba(41, 54, 50, 0.96); border-color: #998b69; color: #eee4c9; font-size: 17px; letter-spacing: 2px; -unity-text-align: middle-center; }
.voyage-hud .primary:hover { background-color: #3c4e46; border-color: #d0bb88; }
.voyage-hud .primary:focus { border-color: #eee4c9; }
.navigation-tools { position: absolute; left: 0; bottom: 0; flex-direction: row; }
.voyage-hud .navigation-tool { margin-right: 12px; min-width: 138px; padding: 10px 16px; font-size: 15px; border-width: 0; border-bottom-width: 1px; border-color: #65766c; background-color: rgba(8, 19, 22, 0.85); }
.voyage-hud .navigation-tool:hover, .voyage-hud .navigation-tool:focus { border-color: #eee4c9; background-color: #263b36; }
.voyage-hud .voyage-map-panel { left: 0; right: 354px; top: 86px; bottom: 64px; }
.chart-open .voyage-navigation { bottom: 64px; }
.chart-open .choosing-route .destination-panel { min-height: 0; }
.sailing-track { width: 250px; height: 2px; margin: 11px 0 13px; background-color: #2a423e; }
.sailing-fill { height: 2px; width: 0; background-color: #c6ad71; }
.voyage-footer { position: absolute; left: 36px; right: 390px; bottom: 14px; flex-direction: row; justify-content: flex-start; }
.chart-open .voyage-footer { left: 360px; bottom: 44px; }
.footer-note { font-size: 13px; color: #e5e2d6; text-shadow: 0 1px 4px #040a0c; }
.voyage-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5, 13, 16, 0.72); align-items: center; justify-content: center; }
.voyage-journal { width: 560px; height: 610px; max-height: 84%; padding: 22px 25px; background-color: rgb(220, 210, 181); border-left-width: 4px; border-left-color: rgb(158, 135, 85); }
.journal-title { margin-bottom: 8px; font-size: 27px; color: rgb(36, 55, 54); letter-spacing: 4px; }
.voyage-journal .muted { color: rgb(86, 98, 82); font-size: 13px; }
.voyage-journal ScrollView { flex-grow: 1; margin-top: 9px; }
.journal-entry { padding: 9px 0; border-bottom-width: 1px; border-bottom-color: rgb(171, 165, 133); color: rgb(40, 61, 57); font-size: 15px; }
.voyage-load-error { position: absolute; left: 34%; right: 34%; top: 27%; padding: 24px; background-color: rgb(8, 19, 22); border-top-width: 2px; border-top-color: rgb(158, 135, 85); }
.save-error { position: absolute; bottom: 14px; left: 30%; right: 30%; padding: 11px 15px; background-color: rgb(68, 37, 32); border-width: 1px; border-color: rgb(205, 153, 105); }
.save-error .body { margin-bottom: 0; }
.save-error .primary { min-height: 34px; margin-top: 7px; }
.voyage-hud .pause, .voyage-hud .settings { left: 50%; top: 50%; translate: -50% -50%; }
.sailing-fog { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(113, 137, 136); }
.is-sailing .voyage-navigation { right: 50%; bottom: 0; width: 280px; translate: 50% 0; }
.is-sailing .destination-panel { align-items: center; }
.is-sailing .destination-panel .section-label, .is-sailing .destination-title, .is-sailing .destination-clue { display: none; }
.is-sailing .destination-panel .bearing { -unity-text-align: middle-center; }

/* Expedition facts stay at the edge; the sea remains the main composition. */
.voyage-header { justify-content: space-between; }
.voyage-status { text-shadow: 0 2px 5px #040a0c; }
.expedition-progress { color: #eee4c9; font-size: 15px; letter-spacing: 1px; }
.resource-strip { margin-top: 8px; flex-direction: row; }
.resource-chip { flex-direction: row; align-items: center; margin-right: 14px; padding: 3px 10px 3px 4px; border-width: 1px; border-radius: 14px; border-color: rgba(158, 135, 85, 0.45); background-color: rgba(4, 12, 14, 0.7); }
.resource-icon { width: 22px; height: 22px; margin-right: 6px; flex-shrink: 0; }
.resource-value { font-size: 15px; color: #eee4c9; white-space: nowrap; }
.node-choice-title { color: #e5e2d6; font-size: 16px; }
.node-choice-description { margin-top: 3px; color: #b9c4bb; font-size: 12px; }
.route-theme { margin-top: 4px; color: #d2c39b; font-size: 13px; }
.voyage-hud .node-choice, .voyage-hud .region-choice { margin-top: 7px; min-height: 62px; padding: 8px 12px; flex-direction: column; align-items: stretch; justify-content: center; border-left-width: 2px; border-left-color: #9f8756; -unity-text-align: middle-left; }
.voyage-hud .node-choice:hover, .voyage-hud .region-choice:hover { border-left-color: #ead59d; }
.region-description { margin-top: 4px; color: #aebbb1; font-size: 12px; }
.reward-open .voyage-navigation { left: 50%; right: auto; top: 50%; bottom: auto; width: 850px; translate: -50% -50%; }
.reward-open .voyage-status, .reward-open .current-location { display: none; }
.reward-open .voyage-header { justify-content: flex-end; }
.reward-open .destination-panel { align-items: center; }
.reward-cards { flex-direction: row; justify-content: center; align-items: center; }
.voyage-hud .reward-card { width: 190px; height: 286px; margin: 0 9px; padding: 0; border-color: #7f6c47; background-color: #0f1d21; }
.reward-card-face { width: 188px; height: 284px; -unity-background-scale-mode: scale-and-crop; }
.voyage-hud .reward-card.selected { border-color: #e5c67f; border-width: 2px; translate: 0 -8px; }
.voyage-hud #reward-confirm { margin-top: 16px; min-width: 140px; }
.voyage-hud .reward-skip { margin-top: 26px; min-width: 230px; align-self: center; border-width: 0; border-bottom-width: 1px; border-bottom-color: #756b55; background-color: rgba(8, 19, 22, 0.7); -unity-text-align: middle-center; }
.act-complete .voyage-navigation { width: 420px; }
.voyage-summary { max-height: 460px; min-height: 0; margin: 12px 0; }
.voyage-summary .body { margin-bottom: 8px; }
.action-book { width: 1120px; max-width: 94%; height: 760px; max-height: 90%; min-height: 0; padding: 24px 28px; background-color: rgb(13, 29, 31); border-width: 1px; border-top-width: 3px; border-color: rgb(158, 135, 85); }
.action-book > .journal-title { flex-shrink: 0; margin-bottom: 18px; color: #e5d4aa; }
.action-book-body { flex-grow: 1; flex-shrink: 1; flex-direction: row; min-width: 0; min-height: 0; }
.action-book-side { width: 230px; min-width: 230px; flex-shrink: 0; padding-right: 24px; border-right-width: 1px; border-right-color: rgba(158, 135, 85, 0.4); }
.action-book-main { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; padding-left: 24px; }
.collection-count { flex-shrink: 0; align-self: flex-end; color: #e5d4aa; font-size: 17px; }
.action-book-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 10px; }
.action-book-cards { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.voyage-hud .action-book-card { width: 142px; height: 214px; margin: 12px; padding: 0; border-width: 2px; border-color: transparent; background-color: #0f1d21; }
.voyage-hud .action-book-card.selected { border-color: #e5c67f; translate: 0 -4px; }
.action-book-card-face { width: 138px; height: 210px; -unity-background-scale-mode: scale-and-crop; }
.tool-count { flex-shrink: 0; color: #d4c49a; font-size: 14px; letter-spacing: 1px; }
.action-book-tools { flex-shrink: 0; }
.voyage-hud .action-book-tool { margin-top: 10px; min-height: 46px; padding: 8px; font-size: 14px; border-left-width: 3px; -unity-text-align: middle-left; }
.voyage-hud .action-book-tool.selected { border-left-color: #e5c67f; background-color: #31473e; color: #fff0c6; }
.action-book-side .modal-actions { flex-grow: 1; flex-direction: column; justify-content: flex-end; }
.action-book-side .modal-actions .primary, .action-book-side .modal-actions .secondary { width: 100%; margin: 10px 0 0 0; min-height: 42px; -unity-text-align: middle-center; }
.voyage-hud .action-book-tool, .voyage-hud .modal-actions Button, .voyage-hud .pause-option, .voyage-utilities Button { white-space: nowrap; }

.preparation-summary { margin: 6px 0; color: #ddcc9e; font-size: 13px; text-shadow: 0 2px 5px #040a0c; }
.support-manifest { width: 850px; border-width: 0; border-left-width: 3px; border-left-color: #9e8755; }
.support-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }
.voyage-hud .support-tabs Button { flex-grow: 1; margin-right: 6px; padding: 8px 10px; white-space: nowrap; border-width: 0; border-bottom-width: 2px; background-color: transparent; font-size: 17px; letter-spacing: 3px; }
.voyage-hud .support-tabs Button.selected { color: #efdbab; border-bottom-color: #c2a16d; background-color: rgba(95, 103, 74, 0.18); }
.support-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.support-illustration { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 0.17; -unity-background-scale-mode: scale-and-crop; }
.support-entry { padding: 10px 2px; border-bottom-width: 1px; border-bottom-color: rgba(158, 135, 85, 0.3); }
.support-entry .node-choice-description { margin-top: 6px; font-size: 14px; }
.voyage-hud .support-entry Button { align-self: flex-start; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 38px; border-width: 0; border-left-width: 2px; border-left-color: #a48b58; background-color: transparent; -unity-text-align: middle-left; }
.support-manifest > .primary { flex-shrink: 0; align-self: flex-end; margin-top: 12px; }

/* Arrival choices and their follow-up actions keep a consistent rhythm. */
.destination-panel > .secondary { margin-top: 8px; -unity-text-align: middle-center; }
.voyage-hud .reward-item { margin-top: 18px; min-width: 230px; align-self: center; flex-direction: row; align-items: center; justify-content: center; border-left-width: 3px; border-left-color: #80b5a5; }
.voyage-hud .reward-item.selected { border-color: #e5c67f; border-width: 2px; }
.reward-item-kind { margin-right: 10px; padding: 1px 6px; font-size: 11px; color: #80b5a5; border-width: 1px; border-radius: 3px; border-color: #80b5a5; }
.reward-item-name { font-size: 16px; color: #eee4c9; }

.voyage-status-seal { flex-direction: row; align-items: center; margin-right: 9px; padding: 3px 8px; border-width: 1px; border-radius: 14px; border-color: rgba(158, 135, 85, 0.55); background-color: rgba(4, 12, 14, 0.76); }
.status-seal-icon { width: 19px; height: 19px; margin-right: 5px; }
.status-seal-label { color: #d7bd82; font-size: 12px; white-space: nowrap; }
.event-title { margin: 4px 0 6px; color: #d7bd82; font-size: 20px; letter-spacing: 2px; }
.perilous-badge { align-self: flex-start; margin-top: 4px; padding: 2px 6px; color: #f2bc9d; font-size: 11px; border-width: 1px; border-color: #ac7566; border-radius: 3px; }

.reward-decision, .reward-replacement, .battle-summary, .region-transition {
    width: 560px;
    max-width: 90%;
    max-height: 84%;
    padding: 24px 28px;
    background-color: rgb(15, 31, 35);
    border-width: 1px;
    border-top-width: 3px;
    border-color: #9e8755;
}
.reward-decision > Button { margin-top: 9px; }
.replacement-cards { height: 430px; min-height: 180px; }
.voyage-hud .replacement-card { width: 142px; height: 214px; margin: 8px; padding: 0; align-self: center; border-color: rgba(158, 135, 85, 0.6); }
.battle-summary { width: 610px; }
.battle-summary ScrollView { max-height: 430px; min-height: 150px; }
.summary-loss { margin: 6px 0 12px; color: #f2bc9d; font-size: 22px; letter-spacing: 2px; }
.region-transition { width: 640px; min-height: 260px; align-items: center; justify-content: center; opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.24s; }
.region-transition-title { color: #eee4c9; font-size: 30px; letter-spacing: 5px; -unity-text-align: middle-center; }
.reduced-motion .region-transition { transition-duration: 0s; translate: 0 0; }
.voyage-hud .action-book-card.new-card { border-color: #80b5a5; }
.voyage-header { height: auto; align-items: flex-start; }
.voyage-utilities Button { flex-direction: row; align-items: center; }
.voyage-hud .node-choice-title { white-space: normal; }
.reward-open .voyage-navigation { max-width: 94%; max-height: 88%; }
.reward-open .destination-panel > .primary, .reward-open .destination-panel > .secondary { min-width: 270px; white-space: nowrap; }
.voyage-hud .reward-skip { margin-top: 12px; }
.reward-replacement-sheet { width: 1040px; max-width: 94%; height: 720px; max-height: 90%; padding: 24px; background-color: #0f1f23; border-width: 1px; border-color: #9e8755; }
.reward-replacement-sheet > .secondary { align-self: flex-end; width: 140px; flex-shrink: 0; }
.debrief-sheet { width: 620px; max-width: 92%; max-height: 84%; padding: 28px; background-color: #0f1f23; border-width: 1px; border-color: #9e8755; }
.debrief-scroll { min-height: 110px; max-height: 450px; flex-shrink: 1; }
.region-intro-sheet { width: 680px; max-width: 92%; padding: 40px; align-items: center; background-color: rgba(8,19,22,.9); border-top-width: 1px; border-bottom-width: 1px; border-color: #9e8755; }
.region-intro-title { font-size: 30px; letter-spacing: 6px; color: #d7bd82; margin: 12px 0 24px; }
.region-intro-sheet > .primary, .region-intro-sheet > .secondary { min-width: 180px; white-space: nowrap; }
.new-reward-card { border-color: #80b5a5; }
.new-reward-badge { position: absolute; top: -14px; right: 0; padding: 2px 5px; background-color: #254b48; color: #eee4c9; font-size: 11px; }
.perilous-badge { flex-direction: row; align-items: center; margin-top: 4px; }
.perilous-badge SeaUiArt { width: 24px; height: 24px; }
.perilous-label, .reward-picks { font-size: 13px; color: #d7bd82; }
.reward-picks { margin-bottom: 15px; }

/* Layout: header facts, then the location name, then one full-height right column read top to bottom. */
.voyage-header { top: 22px; }
.expedition-progress { font-size: 15px; }
.resource-strip { margin-top: 10px; flex-direction: row; align-items: center; }
.resource-chip { height: 32px; margin-right: 10px; padding: 0 12px 0 5px; }
.resource-chip .sanity-state { margin-left: 8px; }
.voyage-status-seal { height: 32px; margin-right: 10px; }
.voyage-workspace { top: 116px; bottom: 28px; }
.location-name { margin-top: 4px; }
.voyage-navigation.column { top: 0; bottom: 0; width: 340px; flex-direction: column; }
.voyage-column-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.voyage-column-scroll > .unity-scroll-view__content-viewport { min-height: 0; }
.voyage-column-scroll .unity-scroller--vertical { width: 10px; margin-left: 6px; }
.voyage-column-scroll .unity-scroller--vertical .unity-base-slider { margin-top: 0; margin-bottom: 0; }
.voyage-column-scroll .unity-scroller__low-button, .voyage-column-scroll .unity-scroller__high-button { display: none; }
.voyage-column-scroll .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; margin-left: 1px; }
.voyage-navigation.column .route-list { margin-bottom: 10px; }
.voyage-navigation.column .destination-panel { padding-right: 4px; }
.voyage-hud .column-primary { flex-shrink: 0; margin-top: 12px; }
.voyage-navigation.column .section-label { margin-top: 14px; margin-bottom: 6px; }
.voyage-navigation.column .node-choice, .voyage-navigation.column .region-choice { margin-top: 0; margin-bottom: 8px; }
.destination-panel > .secondary { margin-top: 0; margin-bottom: 8px; }

/* Reward equipment detail sits in the empty space right of the card row. */
.reward-detail { position: absolute; width: 300px; padding: 18px 20px; background-color: rgba(8,19,22,.92); border-width: 1px; border-left-width: 3px; border-color: rgba(158,135,85,.6); border-left-color: #80b5a5; }
.reward-detail-kind { align-self: flex-start; padding: 1px 6px; font-size: 11px; color: #80b5a5; border-width: 1px; border-radius: 3px; border-color: #80b5a5; }
.reward-detail-name { margin-top: 10px; font-size: 20px; color: #eee4c9; letter-spacing: 2px; }
.reward-detail-body { margin-top: 10px; font-size: 15px; color: #c8d2c8; white-space: normal; }
