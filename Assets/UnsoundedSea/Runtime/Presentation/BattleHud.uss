.battle-hud { background-color: rgba(0,0,0,0); color: #eee4c9; font-size: 15px; }
.unity-label { white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; }
.battle-hud Button { margin: 0; padding: 0; border-width: 0; background-color: rgba(0,0,0,0); color: #eee4c9; white-space: normal; transition-property: translate, scale, rotate, background-color; transition-duration: .14s; }
.battle-hud Button:disabled { opacity: .45; }.section-label,.field-label { font-size: 10px; color: #9e8755; letter-spacing: 1px; }
.pips { flex-direction: row; }.pip { width: 7px; height: 7px; margin-left: 3px; border-width: 1px; border-color: #9e8755; }.pip.filled { background-color: #9e8755; }
.level-tag { font-size: 10px; padding: 1px 4px; border-width: 1px; }.level-observed { border-color: #eee4c9; }.level-verified { color: #081316; background-color: #80b5a5; }.level-rumored { color: #d7bd82; border-color: #9e8755; }.level-unknown { color: #80b5a5; border-color: #80b5a5; }
.encounter-heading { position: absolute; top: 66px; right: 32px; width: 86px; align-items: center; }.encounter-heading SeaUiArt { width: 58px; height: 58px; }.objective-label,.turn-label { font-size: 10px; color: #9e8755; }.objective-count { font-size: 17px; color: #d7bd82; }
.battle-hud .journal-toggle,.battle-hud .menu-toggle,.battle-hud .chart-toggle { position: absolute; top: 18px; padding: 6px 10px; background-color: rgba(8,19,22,.76); border-width: 1px; border-color: rgba(158,135,85,.55); }.journal-toggle { right: 24px; width: 132px; }.menu-toggle { right: 164px; width: 74px; }.chart-toggle { right: 246px; width: 74px; }.toggle-title { font-size: 14px; }.toggle-meta { font-size: 10px; color: #80b5a5; }
.targets { position: absolute; top: 70px; left: 24%; right: 24%; flex-direction: row; justify-content: center; align-items: flex-start; }
.battle-hud .target { width: 205px; margin: 0 12px; padding: 8px 12px; align-items: center; }.battle-hud .target.selected { width: 300px; background-color: rgba(5,16,18,.82); border-top-left-radius: 22px; border-bottom-right-radius: 22px; }.target-state { min-height: 14px; color: #d7bd82; font-size: 10px; }.target-name { font-size: 19px; text-shadow: 0 1px 3px #000; }.target-health { flex-direction: row; align-items: center; width: 100%; }.target-track { flex-grow: 1; height: 4px; background-color: rgba(8,19,22,.75); }.target-fill { height: 4px; background-color: #9b5d50; }.target-value { margin-left: 7px; font-size: 13px; }
.bracket { position: absolute; width: 12px; height: 12px; border-color: rgba(0,0,0,0); }.bracket.tl { top:0;left:0;border-top-width:1px;border-left-width:1px;}.bracket.tr{top:0;right:0;border-top-width:1px;border-right-width:1px;}.bracket.bl{bottom:0;left:0;border-bottom-width:1px;border-left-width:1px;}.bracket.br{bottom:0;right:0;border-bottom-width:1px;border-right-width:1px;}.target.selected .bracket,.target:focus .bracket{border-color:#d7bd82}.target.defeated{opacity:.4}
.tools { position: absolute; top: 185px; right: 24px; width: 88px; }.battle-hud .tool { width: 82px; height: 82px; margin-bottom: 9px; padding: 5px; border-radius: 41px; align-items: center; background-color: rgba(65,54,36,.9); border-width: 1px; border-color: #9e8755; }.tool SeaUiArt { width: 34px; height: 34px; }.tool-name { font-size: 12px; -unity-text-align: middle-center; }.tool-foot { flex-direction: row; }.tool-cost,.tool-uses,.tool-spent { font-size: 9px; }.tool-cost.price { color: #cf8b76; margin-right: 3px; }.tool-uses { color: #d7bd82; }.tool:hover { translate: -5px 0; }.tool:focus { border-width: 2px; border-color: #eee4c9; }
.player-status { position: absolute; bottom: 16px; left: 18px; flex-direction: row; align-items: flex-end; }.vitals { flex-direction: row; }.vital,.action-line { width: 90px; height: 90px; margin-right: -7px; padding: 9px; border-radius: 45px; border-width: 2px; border-color: rgba(158,135,85,.75); background-color: rgba(8,19,22,.84); align-items: center; justify-content: center; }.vital SeaUiArt,.action-line SeaUiArt { position: absolute; width: 65px; height: 65px; opacity: .28; }.vital-line { align-items: center; }.vital-title,.vital-max { font-size: 10px; color: #d7bd82; }.vital-value { font-size: 20px; }.vital-track { width: 52px; height: 3px; background-color: rgba(128,181,165,.25); }.vital-fill { height: 3px; }.health .vital-fill{background-color:#9b5d50}.sanity .vital-fill{background-color:#80b5a5}.vital-tick{display:none}.action-value{font-size:22px;color:#d7bd82}.defenses { position: absolute; left: 280px; bottom: 35px; width: 130px; }.defense { flex-direction: row; }.defense-label { font-size: 10px; color: #80b5a5; margin-right: 5px; }.defense-value { font-size: 14px; }.piles { position: absolute; left: 278px; bottom: 8px; flex-direction: row; }.pile { flex-direction: row; margin-right: 8px; }.pile-label { font-size: 9px; color: #80b5a5; }.pile-value { font-size: 10px; margin-left: 2px; }
.hand { position: absolute; left: 370px; right: 170px; bottom: -140px; height: 440px; }.hand .unity-scroll-view__content-viewport { overflow: hidden; }.hand .unity-scroll-view__content-container { min-width: 100%; height: 434px; padding: 0 14px; }.fan-track { position: relative; height: 426px; min-width: 620px; }
.battle-hud .card-anchor { position:absolute;bottom:8px;width:180px;height:245px;padding:0;border-width:0;background-color:rgba(0,0,0,0);transform-origin:50% 100% }.battle-hud .card { position:absolute;left:0;right:0;top:0;bottom:0;padding:10px 13px;background-color:#d8cbaa;border-width:1px;border-color:#9e8755;border-bottom-width:3px;border-radius:9px 9px 3px 3px;color:#202b2c;transform-origin:50% 100%;transition-property:translate,scale,rotate,background-color;transition-duration:.14s}.card-anchor.inspecting .card{translate:0 -150px;scale:1.1;rotate:0deg;background-color:#eee4c9}.fan--3{rotate:-11deg;translate:0 15px}.fan--2{rotate:-7deg;translate:0 7px}.fan--1{rotate:-3deg;translate:0 2px}.fan-1{rotate:3deg;translate:0 2px}.fan-2{rotate:7deg;translate:0 7px}.fan-3{rotate:11deg;translate:0 15px}.card-top{flex-direction:row;align-items:center}.card-cost{width:29px;height:29px;border-radius:15px;background-color:#19383c;color:#eee4c9;font-size:18px;-unity-text-align:middle-center}.card-cost-label{font-size:10px;color:#655d4b;margin-left:6px}.card SeaUiArt{height:105px;margin:2px 0}.card-name{font-size:17px;color:#202b2c}.card-description{font-size:15px;color:#303c3b;flex-grow:1}.card-price,.card-exhaust,.card-blocked{font-size:10px}.card-price{color:#7d3e35}.card-blocked{color:#eee4c9;background-color:#713d34}.card-anchor:disabled .card{background-color:#aaa593}
.turn-controls { position: absolute; bottom: 17px; right: 22px; width: 112px; align-items: center; }.battle-hud .task { width: 102px; min-height: 54px; margin-bottom: 8px; padding: 7px; border-radius: 28px; background-color: rgba(20,50,49,.9); border-width: 1px; border-color: #80b5a5; }.task-head{align-items:center}.task-name{font-size:13px}.task-note{font-size:9px;color:#80b5a5}.battle-hud .end-turn{width:104px;height:104px;border-radius:52px;border-width:2px;border-color:#d7bd82;background-color:rgba(112,79,38,.94)}.end-turn SeaUiArt{position:absolute;width:82px;height:82px;opacity:.5}.end-title{font-size:17px;-unity-text-align:middle-center}.end-turn:hover{scale:1.06;background-color:#816035}.end-turn:focus{border-color:#eee4c9}
.notice { position:absolute;bottom:300px;left:32%;right:32%;font-size:13px;-unity-text-align:middle-center;color:#eee4c9}.notice.error{background-color:rgba(110,44,32,.88);padding:4px 10px}.notice.hidden{display:none}
.journal{position:absolute;top:70px;right:140px;width:340px;bottom:250px;padding:15px 18px;background-color:#ded3b5;border-width:1px;border-color:#9e8755;border-left-width:4px}.journal-head{flex-direction:row;justify-content:space-between}.journal-title{font-size:22px;color:#202b2c}.journal-subtitle,.evidence-source,.journal-empty{font-size:12px;color:#655d4b}.journal-close{padding:4px 10px;color:#202b2c;border-width:1px;border-color:#9e8755}.journal-entries{flex-grow:1}.journal-section{color:#7d3e35;margin-top:9px}.evidence{padding:6px 0;border-bottom-width:1px;border-bottom-color:#b7a980}.evidence-head,.log-entry{flex-direction:row}.evidence-source{margin-left:6px}.evidence-text{color:#202b2c}.log-turn{width:60px;color:#7d3e35;font-size:11px}.log-text{color:#303c3b;font-size:12px;flex-grow:1}
.outcome{position:absolute;top:35%;left:28%;right:28%;padding:20px 26px;align-items:center;background-color:rgba(8,19,22,.94);border-width:1px;border-color:#9e8755}.outcome-overline{color:#80b5a5}.outcome-title{font-size:30px}.outcome-description{margin:8px 0 14px;-unity-text-align:middle-center}.outcome-actions{flex-direction:row}.restart,.outcome-journal{padding:7px 16px;margin:0 5px;border-width:1px;border-color:#9e8755}.restart{background-color:#9e8755;color:#081316}.concluded .hand,.concluded .tools,.concluded .turn-controls,.concluded .targets{opacity:.3}.concluded .notice{display:none}.error{padding:18px;color:#eee4c9;background-color:#713d34}
.pause-scrim .settings { translate: 0 0; }
.battle-chart-overlay { position:absolute;left:0;right:0;top:0;bottom:0;padding:24px;background-color:rgba(1,8,13,.96) }.battle-chart-overlay VoyageMapPanel { flex-grow:1 }.battle-hud .battle-chart-close { position:absolute;right:38px;bottom:30px;min-width:128px;min-height:40px;padding:8px 14px;border-width:1px;border-color:#d7bd82;background-color:#19383c;color:#eee4c9 }
.reduced-motion Button, .reduced-motion .card, .reduced-motion .sea-card { transition-duration: 0s; }.reduced-motion .card-anchor.inspecting .card { translate: 0 -150px; }

/* Keep the resting hit area stable while straightening the inspected face. */
.fan--3.inspecting .card { rotate: 11deg; }
.fan--2.inspecting .card { rotate: 7deg; }
.fan--1.inspecting .card { rotate: 3deg; }
.fan-1.inspecting .card { rotate: -3deg; }
.fan-2.inspecting .card { rotate: -7deg; }
.fan-3.inspecting .card { rotate: -11deg; }

.card-target-panel { position: absolute; left: 50%; top: 92px; width: 420px; max-height: 470px; translate: -50% 0; padding: 14px 18px; background-color: rgba(5,16,18,.96); border-width: 1px; border-color: #9e8755; border-top-left-radius: 22px; border-bottom-right-radius: 22px; }
.card-target-title { color: #d7bd82; font-size: 18px; margin-bottom: 8px; -unity-text-align: middle-center; }
.card-target-choice { min-height: 48px; margin: 4px 0; padding: 6px 10px; white-space: normal; color: #eee4c9; background-color: #19383c; border-width: 1px; border-color: rgba(158,135,85,.65); }
.card-target-choice:hover, .card-target-choice:focus { border-width: 2px; border-color: #eee4c9; background-color: #254b48; }
.chosen-card .card { translate: 0 -90px; border-width: 3px; border-color: #f6e8ac; }
