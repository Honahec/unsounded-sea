.ocean-ui { color: #eee4c9; font-size: 15px; }
.ocean-ui Label { white-space: normal; }
.battle-surface { position: absolute; left: 0; right: 0; top: 0; bottom: 150px; }
.sea-top { position: absolute; top: 24px; right: 28px; flex-direction: row; }
.sea-button { min-height: 38px; margin-left: 8px; padding: 8px 14px; border-width: 1px; border-radius: 2px; border-color: rgba(158,135,85,.4); background-color: rgba(8,19,22,.82); color: #eee4c9; }
.sea-button:hover { background-color: rgba(30,53,52,.94); border-color: #b3a482; }
.sea-top .sea-button { min-width: 92px; margin-left: 12px; padding: 7px 4px; border-width: 0; background-color: transparent; font-size: 14px; }
.sea-top .sea-button:hover, .sea-top .sea-button:focus { color: #d7bd82; background-color: rgba(8,19,22,.55); }
.sea-button:focus, .tool:focus, .end-turn:focus { border-color: #eee4c9; }
.sea-card:focus, .actor-label:focus { border-bottom-color: #eee4c9; }
.tool:disabled, .end-turn:disabled { opacity: .4; }
.ocean-ui .feedback-locked:disabled { opacity: 1; }
.intel-name { color: #d7bd82; font-size: 12px; letter-spacing: 2px; }
.clue { margin-top: 3px; font-size: 15px; -unity-text-align: middle-center; text-shadow: 0 1px 2px #020708; }
.intel-text { margin-top: 3px; color: #80b5a5; font-size: 14px; -unity-text-align: middle-center; }
.tools { position: absolute; left: 36px; bottom: 192px; width: 260px; }
.tool-focus { margin-bottom: 7px; color: #d7bd82; font-size: 12px; letter-spacing: 1px; }
.tool SeaUiArt { width: 26px; height: 26px; margin-right: 8px; flex-shrink: 0; }
.tool-name { flex-grow: 1; flex-shrink: 1; }
.tool { min-height: 42px; margin: 0 0 8px; padding: 9px 12px; border-radius: 2px 14px 2px 2px; border-width: 1px; border-left-width: 3px; border-color: rgba(158,135,85,.35); border-left-color: #9e8755; background-color: rgba(8,19,22,.82); color: #eee4c9; flex-direction: row; align-items: center; justify-content: space-between; }
.tool:hover { background-color: #263b36; border-color: #b3a482; }
.tool-name { font-size: 16px; }
.tool-meta { font-size: 13px; color: #c6b58e; margin-left: 10px; }
.battle-objective { position: absolute; left: 36px; top: 28px; flex-direction: row; align-items: center; padding: 0 0 8px; border-bottom-width: 1px; border-bottom-color: rgba(158,135,85,.5); }
.objective-label { font-size: 18px; color: #eee4c9; margin-right: 18px; text-shadow: 0 2px 5px #040a0c; }
.objective-count { font-size: 20px; color: #d7bd82; text-shadow: 0 2px 5px #040a0c; }
.turn-controls { position: absolute; right: 28px; bottom: 28px; width: 168px; }
.turn-number { font-size: 13px; color: #a9b6ad; -unity-text-align: middle-right; text-shadow: 0 2px 5px #040a0c; }
.action-budget { flex-direction: row; justify-content: space-between; align-items: center; min-height: 42px; margin-bottom: 10px; }
.action-label { font-size: 15px; color: #c6b58e; }
.action-value { font-size: 23px; color: #eee4c9; text-shadow: 0 2px 5px #040a0c; }
.battle-vitals { position: absolute; left: 36px; bottom: 24px; width: 270px; }
.vital { margin-top: 12px; }
.vital:first-child { margin-top: 0; }
.vital-heading { flex-direction: row; align-items: center; min-height: 30px; }
.vital-icon { width: 22px; height: 22px; margin-right: 8px; flex-shrink: 0; }
.vital-label { font-size: 16px; color: #cbd1c5; text-shadow: 0 2px 5px #040a0c; }
.vital-heading .sanity-state { margin-left: 8px; }
.vital-value { margin-left: auto; font-size: 21px; color: #eee4c9; white-space: nowrap; text-shadow: 0 2px 5px #040a0c; }
.vital-track { position: relative; height: 6px; margin-top: 6px; overflow: visible; border-radius: 3px; background-color: rgba(4,12,14,.75); }
.vital-fill { height: 6px; border-radius: 3px; background-color: #ac7566; }
.sanity .vital-fill { background-color: #80b5a5; }
.vital-protection { min-height: 18px; padding-top: 4px; font-size: 13px; color: #b6c9b7; text-shadow: 0 2px 5px #040a0c; }
/* Extra headroom above resting cards so a lifted (inspected) card is never clipped by the hand viewport. */
.hand { position: absolute; left: 310px; right: 310px; bottom: -140px; height: 510px; }
.hand .unity-scroll-view__content-viewport { overflow: hidden; }
.hand .unity-scroll-view__content-container { min-width: 100%; height: 504px; padding: 0 15px; }
.fan-track { position: relative; height: 496px; }
.card-anchor { position: absolute; bottom: 8px; width: 180px; height: 245px; padding: 0; border-width: 0; background-color: rgba(0,0,0,0); transform-origin: 50% 100%; }
.sea-card { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 10px 13px; border-radius: 9px 9px 3px 3px; border-width: 1px; border-bottom-width: 3px; border-color: #9e8755; background-color: #d8cbaa; color: #172526; transform-origin: 50% 100%; transition-property: translate, scale, rotate, background-color, opacity; transition-duration: .14s; -unity-text-align: upper-left; }
.card-anchor.inspecting .sea-card { translate: 0 -150px; scale: 1.1; rotate: 0deg; background-color: #eee4c9; }
.card-anchor.card-entering .sea-card { translate: 0 42px; opacity: 0; }
.fan--3 { rotate: -11deg; translate: 0 15px; }.fan--2 { rotate: -7deg; translate: 0 7px; }.fan--1 { rotate: -3deg; translate: 0 2px; }.fan-1 { rotate: 3deg; translate: 0 2px; }.fan-2 { rotate: 7deg; translate: 0 7px; }.fan-3 { rotate: 11deg; translate: 0 15px; }

.card-head { flex-direction: row; justify-content: space-between; align-items: center; }
.card-cost { width: 29px; height: 29px; border-radius: 15px; background-color: #19383c; color: #eee4c9; font-size: 18px; -unity-text-align: middle-center; }
.card-type { font-size: 10px; color: #655d4b; }
.sea-card SeaUiArt { height: 105px; margin: 2px 0; }
.card-name { font-size: 17px; color: #202b2c; }
.card-description { font-size: 15px; color: #303c3b; flex-grow: 1; }
.fine-print { font-size: 10px; color: #7d3e35; }
.end-turn { align-self: center; width: 88px; height: 88px; min-height: 88px; flex-shrink: 0; margin: 0; padding: 0; border-width: 0; background-color: transparent; }
.end-turn:hover, .end-turn:focus { background-color: transparent; }
.end-turn SeaUiArt { width: 88px; height: 88px; }
.end-turn:hover SeaUiArt, .end-turn:focus SeaUiArt { scale: 1.08; }
.end-title { margin-top: 10px; font-size: 17px; color: #eee4c9; -unity-text-align: middle-center; }
.battle-subtitle { position: absolute; bottom: 310px; left: 25%; right: 25%; padding: 8px 14px; font-size: 18px; white-space: normal; -unity-text-align: middle-center; color: #eee4c9; text-shadow: 0 2px 4px #000; background-color: rgba(8,19,22,.78); }
.actor-label { position: absolute; width: 285px; min-height: 48px; padding: 3px 8px; border-width: 0; background-color: transparent; color: #eee4c9; align-items: flex-start; }
.actor-name, .actor-status { -unity-text-align: middle-left; text-shadow: 0 1px 3px #000; }.actor-name { font-size: 18px; }.actor-status { font-size: 13px; color: #80b5a5; }
.actor-health { width: 164px; height: 4px; margin-top: 5px; background-color: rgba(8,19,22,.7); }.actor-health-fill { height: 4px; background-color: #9b5d50; }
.actor-immune { width: 22px; height: 22px; margin-top: 4px; }
.actor-label.selected { border-left-width: 2px; border-left-color: #d7bd82; }
.boss-status { position: absolute; left: 26px; top: 70px; max-width: 360px; color: #eee4c9; font-size: 16px; text-shadow: 0 1px 3px #000; }
.boss-target { position: absolute; min-width: 44px; min-height: 40px; max-width: 170px; padding: 3px 7px; margin: 0; border-width: 1px; border-radius: 12px 3px; border-color: rgba(158,135,85,.65); color: #eee4c9; background-color: rgba(8,19,22,.83); font-size: 13px; -unity-text-align: middle-center; white-space: normal; }
.boss-target:disabled { opacity: 1; color: #c4c7b5; background-color: rgba(8,19,22,.65); }
.boss-target.target-ready { border-color: #d7bd82; border-width: 2px; color: #fff0c9; }
.boss-target:hover, .boss-target:focus { border-color: #eee4c9; background-color: #254b48; }
.boss-target-prompt { position: absolute; left: 25%; right: 25%; top: 22px; flex-direction: row; justify-content: center; align-items: center; }
.boss-target-prompt-text { color: #d7bd82; font-size: 17px; text-shadow: 0 1px 3px #000; }
.boss-target-prompt .key-badge { margin-left: 10px; }
.salt-board { position: absolute; left: 32px; top: 140px; width: 332px; flex-direction: row; flex-wrap: wrap; padding: 10px; background-color: rgba(8,19,22,.9); border-width: 2px; border-color: #8f7951; border-radius: 24px 5px; }
.boss-target.salt-cell { position: relative; width: 68px; height: 68px; min-width: 68px; margin: 3px; padding: 2px; font-size: 15px; border-radius: 3px; }
.boss-target.mechanism-dial { width: 90px; height: 90px; min-width: 90px; border-radius: 45px; border-width: 2px; border-color: #b59b62; font-size: 17px; background-color: rgba(12,31,32,.94); }
.encounter-card .sea-card { border-color: #80b5a5; border-top-width: 3px; }
.chosen-card .sea-card { translate: 0 -90px; border-color: #f6e8ac; border-width: 3px; }
.ocean-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(1,8,13,.91); }
.ocean-sheet { width: 620px; max-height: 92%; padding: 26px 38px; background-color: rgb(15,31,35); border-width: 1px; border-color: #9e8755; }
.modal-title { font-size: 28px; margin-bottom: 12px; letter-spacing: 3px; }.modal-copy { color: #b9cbc2; margin-bottom: 12px; }.journal { height: 180px; margin-bottom: 14px; }.log-line { font-size: 13px; color: #80b5a5; margin-bottom: 5px; }
.ocean-sheet .settings { position: relative; left: 0; top: 0; width: 100%; translate: 0 0; }
.ocean-sheet.pause { position: relative; left: auto; top: auto; translate: 0 0; width: 360px; }
.ocean-sheet .pause-option { min-height: 44px; padding: 10px 14px; margin-top: 10px; border-width: 0; border-bottom-width: 1px; border-color: rgba(158,135,85,.35); background-color: transparent; color: #eee4c9; font-size: 19px; }
.ocean-sheet .pause-option:hover, .ocean-sheet .pause-option:focus { color: #d7bd82; background-color: rgba(38,62,54,.6); }
.ocean-sheet .pause-option, .sea-top .sea-button { white-space: nowrap; }
.battle-chart-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 24px; background-color: rgba(1,8,13,.96); }
.battle-chart-overlay VoyageMapPanel { flex-grow: 1; }
.battle-chart-close { position: absolute; left: -20px; top: -20px; width: 40px; height: 40px; min-width: 40px; margin: 0; padding: 0 0 3px 0; border-width: 2px; border-radius: 20px; border-color: #d7bd82; background-color: #19383c; color: #eee4c9; font-size: 26px; -unity-text-align: middle-center; }
.battle-chart-close:hover, .battle-chart-close:focus { border-color: #eee4c9; background-color: #254b48; color: #fff0c9; }
.battle-chart-overlay .map-heading { padding-left: 28px; }
.ocean-ui.reduced-motion Button, .reduced-motion .card, .reduced-motion .sea-card { transition-duration: 0s; }.ocean-ui.reduced-motion .card-anchor.inspecting .sea-card { translate: 0 -150px; }.ocean-ui.reduced-motion .card-anchor.card-entering .sea-card { translate: 0 0; opacity: 1; }

/* Keep the resting hit area stable while straightening the inspected face. */
.fan--3.inspecting .sea-card { rotate: 11deg; }
.fan--2.inspecting .sea-card { rotate: 7deg; }
.fan--1.inspecting .sea-card { rotate: 3deg; }
.fan-1.inspecting .sea-card { rotate: -3deg; }
.fan-2.inspecting .sea-card { rotate: -7deg; }
.fan-3.inspecting .sea-card { rotate: -11deg; }
.card-target-panel { position: absolute; right: 32px; top: 118px; width: 310px; max-height: 430px; padding: 14px 18px; background-color: rgba(5,16,18,.95); border-width: 1px; border-color: #9e8755; border-top-left-radius: 22px; border-bottom-right-radius: 22px; }
.card-target-title { color: #d7bd82; font-size: 18px; margin-bottom: 8px; -unity-text-align: middle-center; }
.card-target-choice { min-height: 48px; margin: 4px 0; padding: 6px 10px; white-space: normal; color: #eee4c9; background-color: #19383c; border-width: 1px; border-color: rgba(158,135,85,.65); }
.card-target-choice.target-ready:hover, .card-target-choice.target-ready:focus { border-width: 2px; border-color: #eee4c9; background-color: #254b48; }
.card-target-cancel { min-height: 34px; margin-top: 7px; color: #c6b58e; background-color: rgba(0,0,0,0); border-width: 0; }
.card-target-cancel:hover, .card-target-cancel:focus { color: #eee4c9; }
.card-disabled .sea-card { opacity: .72; border-color: #8b6258; }
.card-play-feedback { position: absolute; left: 50%; bottom: 282px; translate: -50% 0; padding: 6px 14px; color: #fff0c9; background-color: rgba(8,19,22,.9); border-bottom-width: 1px; border-bottom-color: #d7bd82; opacity: 1; transition-property: translate, opacity; transition-duration: .16s; }
.card-play-feedback.departing { translate: -50% -18px; opacity: 0; }
.ocean-ui.reduced-motion .card-play-feedback { transition-duration: 0s; }

.pile-summary { color: #c6b58e; font-size: 14px; margin-bottom: 14px; }
.enemy-choice { position: absolute; width: 48px; height: 48px; margin: 0; border-width: 2px; border-color: #d7bd82; border-radius: 24px; background-color: rgba(0,0,0,0); }
.enemy-choice:hover, .enemy-choice:focus, .enemy-choice.selected { border-color: #fff0c9; background-color: #254b48; }

/* The dragged face lives above the hand's clipping viewport; the original keeps its slot. */
.card-anchor.drag-source .sea-card { opacity: 0; }
.card-flight { position: absolute; width: 180px; height: 245px; border-width: 2px; border-color: #e6c684; border-radius: 9px; transform-origin: 50% 50%; }
.battle-piles { flex-direction: row; justify-content: space-between; margin-bottom: 10px; }
.pile-count { width: 52px; height: 52px; align-items: center; justify-content: center; border-width: 1px; border-radius: 4px 12px 4px 12px; border-color: rgba(158,135,85,.55); background-color: rgba(5,16,20,.8); }
.pile-name { font-size: 11px; color: #a9b6ad; -unity-text-align: middle-center; }
.pile-value { font-size: 19px; color: #eee4c9; -unity-text-align: middle-center; }
.combat-float { position: absolute; width: 140px; font-size: 25px; -unity-font-style: bold; -unity-text-align: middle-center; text-shadow: 0 2px 4px #000; }
.combat-banner { position: absolute; left: 35%; right: 35%; top: 22%; padding: 14px; font-size: 25px; color: #eee4c9; -unity-text-align: middle-center; background-color: rgba(6,17,21,.78); border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(230,198,132,.5); }
.actor-label.drop-hover, .boss-target.drop-hover, .card-target-choice.drop-hover { background-color: rgba(45,90,79,.85); border-color: #b4e9d8; }
.end-turn SeaUiArt { transition-property: scale, rotate; transition-duration: .18s; transition-timing-function: ease-out-cubic; }
.end-turn:active SeaUiArt { scale: 0.94; rotate: 6deg; }
.sea-card { transition-duration: .2s; transition-timing-function: ease-out-cubic; }
.ocean-ui.reduced-motion .end-turn SeaUiArt, .ocean-ui.reduced-motion .sea-card { transition-duration: 0s; }

.watched { min-height: 40px; flex-direction: row; align-items: center; color: #80b5a5; }
.watched SeaUiArt { width: 24px; height: 24px; margin-right: 7px; }
.watched-value { font-size: 18px; color: #eee4c9; }

.actor-heading { min-height: 26px; flex-direction: row; align-items: center; }
.actor-heading .actor-name { flex-shrink: 1; }
.enemy-badge { min-height: 20px; margin-left: 7px; padding: 2px 6px; border-width: 1px; border-color: rgba(128,181,165,.65); border-radius: 9px; color: #80b5a5; font-size: 12px; white-space: nowrap; }
.surge-badge { border-color: #ac7566; color: #f2bc9d; }
.surge-feedback { margin-left: 6px; color: #f2bc9d; font-size: 12px; white-space: nowrap; transition-property: opacity; transition-duration: .18s; }
.reduced-motion .surge-feedback { transition-duration: 0s; }
.actor-evidence { min-height: 24px; flex-direction: row; align-items: center; }
.actor-evidence SeaUiArt { width: 20px; height: 20px; margin-right: 5px; }
.actor-evidence-text { max-width: 244px; color: #d7bd82; font-size: 12px; white-space: nowrap; overflow: hidden; }
.enemy-current-answer { font-size: 12px; color: #80b5a5; margin-top: 3px; white-space: normal; }

.compact-card-effect { position: absolute; left: 8px; right: 8px; top: 108px; height: 24px; padding: 3px 7px; color: #eee4c9; background-color: rgba(5,16,18,.88); font-size: 12px; white-space: nowrap; overflow: hidden; -unity-text-overflow-position: end; }
.card-anchor.inspecting .compact-card-effect, .card-anchor.chosen-card .compact-card-effect { display: none; }

.boss-target.salt-cell { align-items: center; justify-content: center; }
.salt-symbol { color: #a9b6ad; font-size: 25px; }
.salt-number { color: #80b5a5; font-size: 24px; }
.salt-danger { color: #f2bc9d; font-size: 27px; }
.salt-seal { position: absolute; right: 5px; bottom: 3px; color: #d7bd82; font-size: 14px; }
.salt-measured { border-style: dashed; border-color: #80b5a5; }
.salt-open { background-color: rgba(25,56,60,.94); }

/* These additions apply only to M02-M04 battle roots. */
.m02-battle .choir-name { font-size: 15px; color: #eee4c9; }
.m02-battle .choir-state { font-size: 11px; color: #d7bd82; }
.m03-battle .salt-coordinate { position: absolute; left: 4px; top: 2px; font-size: 11px; color: #d7bd82; }
.m03-battle .salt-note { position: absolute; right: 4px; top: 2px; font-size: 16px; color: #f2bc9d; }
.m04-battle .relay-coordinate { position: absolute; top: 3px; left: 7px; font-size: 12px; color: #d7bd82; }
.m04-battle .relay-complete { position: absolute; bottom: 4px; font-size: 11px; color: #80b5a5; }
.m02-battle .mechanism-complete, .m04-battle .mechanism-complete { border-color: #80b5a5; background-color: rgba(25,56,60,.94); }
.boss-mechanics-battle .boss-mechanism-panel { position: absolute; left: 26px; top: 136px; width: 354px; padding: 12px; border-left-width: 2px; border-left-color: #9e8755; background-color: rgba(5,16,20,.91); }
.boss-mechanics-battle .mechanism-title { font-size: 19px; color: #eee4c9; margin-bottom: 5px; }
.boss-mechanics-battle .mechanism-caption { font-size: 12px; color: #d7bd82; margin-bottom: 10px; white-space: normal; }
.boss-mechanics-battle .mechanism-tile { position: relative; max-width: none; margin: 3px; border-radius: 3px; padding: 5px; align-items: center; justify-content: center; }
.boss-mechanics-battle .mechanism-footnote { margin-top: 6px; font-size: 11px; color: #a9b6ad; }
.m02-battle .choir-row { flex-direction: row; }
.m02-battle .choir-row .mechanism-tile { width: 100px; height: 72px; }
.m02-battle .choir-name { font-size: 23px; margin-bottom: 5px; }
.m03-battle .boss-salt-grid { flex-direction: row; flex-wrap: wrap; }
.m03-battle .boss-salt-grid .salt-cell { width: 75px; height: 75px; min-width: 75px; margin: 3px; }
.m03-battle .boss-salt-grid .salt-number { font-size: 25px; }
.m04-battle .boss-relays { margin-bottom: 8px; }
.m04-battle .boss-relay-column { flex-direction: row; align-items: center; }
.m04-battle .relay-heading { width: 40px; font-size: 12px; color: #d7bd82; white-space: normal; }
.m04-battle .boss-relay-column .mechanism-tile { width: 88px; min-width: 70px; height: 46px; flex-shrink: 1; }
.m04-battle .relay-option { font-size: 13px; color: #eee4c9; }
.m04-battle .relay-current-note { position: absolute; top: 1px; right: 3px; font-size: 10px; color: #80b5a5; }
.m04-battle .relay-selected { border-width: 2px; border-color: #80b5a5; background-color: #254b48; }
.m04-battle .boss-lock-row { min-height: 48px; align-items: flex-start; padding: 5px 8px; }
.m04-battle .lock-name { font-size: 14px; color: #eee4c9; }
.m04-battle .lock-condition { font-size: 11px; color: #a9b6ad; white-space: normal; }

.boss-target.mechanism-dial { position: absolute; align-items: center; justify-content: center; }
.relay-symbol { color: #eee4c9; font-size: 28px; }
.relay-one { left: 50px; }
.relay-two { left: 190px; }
.relay-off { top: 190px; }
.relay-positive { top: 290px; }
.relay-reverse { top: 390px; }
.relay-current { border-width: 3px; border-color: #80b5a5; background-color: #254b48; }
.relay-lock { top: 230px; }
.relay-lock-i { left: 70px; }
.relay-lock-ii { left: 180px; }
.relay-lock-iii { left: 290px; }
.boss-target:focus, .actor-label:focus { border-width: 2px; border-color: #eee4c9; }
.sea-top .sea-button { flex-direction: row; align-items: center; }
/* In battle the chart floats with margins so its corner × stays fully on screen. */
.battle-chart-overlay .voyage-map-panel { left: 12%; right: 12%; top: 56px; bottom: 40px; }
